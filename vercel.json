{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders?key=ZOLA-REMIND-2026",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/reminders?key=ZOLA-REMIND-2026",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  }
}
