{
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders?key=ZOLA-REMIND-2026",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/reminders?key=ZOLA-REMIND-2026",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    }
  }
}
